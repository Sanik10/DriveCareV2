# Database
DATABASE_URL=postgresql://postgres:NEW_STRONG_PASSWORD@localhost:5433/drivecare
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=(openssl rand -base64 32)
POSTGRES_DATABASE=drivecare

# Redis - ИСПРАВЛЕНО!
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=(openssl rand -base64 32)

# JWT
JWT_SECRET=(openssl rand -base64 64)
JWT_REFRESH_SECRET=(openssl rand -base64 64)
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
APP_VERSION=2.0

# CORS (разделяй запятыми)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Swagger
SWAGGER_PATH=docs
SWAGGER_TITLE=DriveCare API
SWAGGER_DESCRIPTION=Система управления автосервисом - API документация

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001/api/v1
