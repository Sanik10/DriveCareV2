# path: apps/backend/.env.example
# =========================
# Core: Database
# =========================
DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@localhost:5433/drivecare
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=(openssl rand -base64 32)
POSTGRES_DATABASE=drivecare

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=(openssl rand -base64 32)

# =========================
# JWT / Auth
# =========================
JWT_SECRET=(openssl rand -base64 64)
JWT_REFRESH_SECRET=(openssl rand -base64 64)
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Refresh hardening (обязательны)
RT_PEPPER=(openssl rand -base64 24)
RT_HMAC_SECRET=(openssl rand -base64 48)

# Дополнительные секреты безопасности
PWD_PEPPER=(openssl rand -base64 32)
DEVICE_ID_SECRET=(openssl rand -base64 32)

# =========================
# Application
# =========================
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
APP_VERSION=2.0

# =========================
# CORS / Swagger / Frontend
# =========================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:3001/api/v1

SWAGGER_PATH=docs
SWAGGER_TITLE=DriveCare API
SWAGGER_DESCRIPTION=Система управления автосервисом - API документация

# =========================
# Compliance (РФ)
# =========================
SERVER_REGION=RU
SERVER_LOCATION=Russia
DATA_PROCESSING_LOCATION=RU

# =========================
# Privacy (152‑ФЗ)
# =========================
PRIVACY_POLICY_VERSION=1.0
# Для prod ОБЯЗАТЕЛЬНО: SHA‑256 (hex) текста политики:
# echo -n "policy-text" | shasum -a 256
# PRIVACY_POLICY_TEXT_HASH=<sha256-hex>
# Dev fallback (не использовать в проде):
PRIVACY_POLICY_TEXT=DriveCare Privacy Policy RU v1.0

COMPLIANCE_STRICT_MODE=true
ENABLE_MIR_SUPPORT=true
ENABLE_COMPLIANCE_MONITORING=true
ENABLE_SECURITY_MONITORING=true
ENABLE_FINANCIAL_MONITORING=true

# Аудит (цепочка целостности) — В PROD обязателен реальный ключ
AUDIT_CHAIN_KEY=(openssl rand -base64 32)

# =========================
# Billing / Payments
# =========================
PAYMENT_GATEWAYS=yookassa,tinkoff
DEFAULT_PAYMENT_PROVIDER=yookassa

# YooKassa (prod: ОБЯЗАТЕЛЬНО)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_IP_WHITELIST=

# Tinkoff (prod: ОБЯЗАТЕЛЬНО)
TINKOFF_TERMINAL_KEY=
TINKOFF_PASSWORD=

# Шифрование конфигов метод-ключей (AES‑256‑GCM, 32 байта base64)
PM_ENC_KEY=(openssl rand -base64 32)

# ККТ (54‑ФЗ)
ENABLE_FISCALIZATION=false
KKT_SERIAL_NUMBER=

# =========================
# Orders module
# =========================
ORDER_DATA_RETENTION_YEARS=5
SANITIZE_NOTES_ENABLED=true
# ORDER_MAX_PARTS_PER_ORDER=100
# ORDER_MAX_SERVICES_PER_ORDER=50