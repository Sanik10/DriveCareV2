# DriveCare V2 — Example .env.example (Backend)
# Copy to .env and fill secrets for your environment.

# =========================
# Core: Database
# =========================
# Use either DATABASE_URL or individual POSTGRES_* settings
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD= # openssl rand -base64 24
POSTGRES_DATABASE=drivecare

# =========================
# Redis
# =========================
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD= # openssl rand -base64 24

# =========================
# JWT / Auth
# =========================
# HS256 (dev) or RS256/ES256 (prod) — if using RS/ES, set JWT_PRIVATE_KEY/JWT_PUBLIC_KEY
JWT_ALG=HS256
JWT_SECRET= # openssl rand -base64 48
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET= # openssl rand -base64 64
JWT_REFRESH_EXPIRATION=7d

# Refresh hardening
RT_PEPPER= # openssl rand -base64 32
RT_HMAC_SECRET= # openssl rand -base64 48

# Password pepper / Device ID
PWD_PEPPER= # openssl rand -base64 48
DEVICE_ID_SECRET= # openssl rand -base64 32

# =========================
# Cookies
# =========================
COOKIE_SECRET= # openssl rand -base64 32

# =========================
# Application
# =========================
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
APP_VERSION=2.0

# =========================
# CORS / Swagger / Frontend
# =========================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:5173
SWAGGER_PATH=docs
SWAGGER_TITLE=DriveCare API
SWAGGER_DESCRIPTION=Система управления автосервисом - API документация

# =========================
# Compliance / Privacy (152-ФЗ)
# =========================
SERVER_REGION=RU
SERVER_LOCATION=Russia
DATA_PROCESSING_LOCATION=RU

PRIVACY_POLICY_VERSION=1.0
PRIVACY_POLICY_TEXT=DriveCare Privacy Policy RU v1.0
# PROD: required — PRIVACY_POLICY_TEXT_HASH (хэш SHA-256 текста политики)
PRIVACY_POLICY_TEXT_HASH= # echo -n "Paste policy text here" | shasum -a 256 | awk '{print $1}'

COMPLIANCE_STRICT_MODE=true
ENABLE_MIR_SUPPORT=true
ENABLE_COMPLIANCE_MONITORING=true
ENABLE_SECURITY_MONITORING=true
ENABLE_FINANCIAL_MONITORING=true

# Audit chain integrity key (min 32 chars)
AUDIT_CHAIN_KEY= # openssl rand -base64 48
# Enable DB audit logging (recommended true in production)
AUDIT_LOG_TO_DB=false

# =========================
# Billing / Payments
# =========================
PAYMENT_GATEWAYS=yookassa,tinkoff
DEFAULT_PAYMENT_PROVIDER=yookassa

# YooKassa credentials (from provider dashboard)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_IP_WHITELIST=

# Tinkoff credentials (from provider dashboard)
TINKOFF_TERMINAL_KEY=
TINKOFF_PASSWORD=

# Webhook paths (subscription billing)
YOOKASSA_WEBHOOK_PATH=subscription-billing/webhooks/yookassa
TINKOFF_WEBHOOK_PATH=subscription-billing/webhooks/tinkoff

# Webhook paths (one-time payments — used later in P0.2)
YOOKASSA_PAYMENTS_WEBHOOK_PATH=payments/webhooks/yookassa
TINKOFF_PAYMENTS_WEBHOOK_PATH=payments/webhooks/tinkoff

# PSP webhooks security
WEBHOOK_ALLOWED_IPS= # comma-separated list of CIDRs/IPs per PSP docs
WEBHOOK_IDEMPOTENCY_TTL_SEC=300

# 32-byte base64 key (AES-256-GCM)
PM_ENC_KEY= # openssl rand -base64 32

ENABLE_FISCALIZATION=false
KKT_SERIAL_NUMBER=

# =========================
# Orders module
# =========================
ORDER_DATA_RETENTION_YEARS=5
SANITIZE_NOTES_ENABLED=true
# ORDER_MAX_PARTS_PER_ORDER=100
# ORDER_MAX_SERVICES_PER_ORDER=50

# =========================
# Inventory module
# =========================
INVENTORY_IDEMPOTENCY_TTL_MS=21600000
INVENTORY_MAX_PAGE_SIZE=100
SANITIZE_INVENTORY_TEXTS=true
INVENTORY_ALERTS_ENABLED=true
INVENTORY_ALERTS_CRON=0 * * * *
INVENTORY_LOW_STOCK_THRESHOLD_DEFAULT=5

# =========================
# Email (SMTP) — optional
# If EMAIL_ENABLED=false or SMTP_* empty — sending is disabled (safe no-op/log)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@drivecare.local
SMTP_SECURE=false

# =========================
# Service History module
# =========================
SERVICE_HISTORY_MAX_PAGE_SIZE=100
SERVICE_HISTORY_DEFAULT_PAGE_SIZE=20
SANITIZE_SERVICE_HISTORY_TEXTS=true
SERVICE_HISTORY_SEARCH_LIMIT=50
SERVICE_HISTORY_NOTIFICATIONS_ENABLED=false

# =========================
# Tariffs module
# =========================
SANITIZE_TARIFF_TEXTS=true
TARIFFS_MAX_PAGE_SIZE=100
TARIFFS_CACHE_TTL_SEC=3600

# =========================
# Customers / Appointments (retention)
# =========================
CUSTOMER_DATA_RETENTION_YEARS=5
SANITIZE_CUSTOMER_TEXTS=true
MAX_CUSTOMERS_PAGE_SIZE=100
CUSTOMER_RETENTION_CRON=0 3 * * * # daily at 03:00

SANITIZE_APPOINTMENT_TEXTS=true
APPOINTMENTS_MAX_PAGE_SIZE=100
APPOINTMENTS_IDEMPOTENCY_TTL_MS=600000
APPOINTMENTS_ALLOW_OVERLAP=false
APPOINTMENTS_TIMEZONE_DEFAULT=Europe/Moscow
APPOINTMENT_DATA_RETENTION_YEARS=5
APPOINTMENTS_REMINDERS_ENABLED=false
APPOINTMENTS_REMINDERS_CRON=0 9 * * *

# =========================
# Seeds / Schema
# =========================
SEEDS_ENABLED=true
DB_AUTO_SYNC_ON_SEEDS=false
ALLOW_STAGING_SEEDS=false

# =========================
# Database logging
# =========================
# Включить подробные query-логи TypeORM (не рекомендуется на стендах с реальными ПДн)
DB_LOG_QUERIES=false
# Порог «медленных запросов» (мс). 0 = выключено. Пример: 500
DB_SLOW_QUERY_THRESHOLD_MS=0

# =========================
# Work-Schedules (exceptions retention)
# =========================
WORK_SCHEDULE_EXCEPTIONS_RETENTION_YEARS=5
WORK_SCHEDULE_EXCEPTIONS_ANON_CRON=0 4 * * *
# Enforce customer subscription limits (production=true by default; set false to disable in dev/stage)
CUSTOMERS_ENFORCE_LIMITS=false
